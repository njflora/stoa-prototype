    "build-only": "vite build",
    "build:pages": "run-p type-check \"build-only -- --mode pages\"",
    "preview:pages": "vite preview --mode pages",
    "type-check": "vue-tsc --build"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "minisearch": "^7.2.0",
