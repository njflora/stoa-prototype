# Copy this file to .env.local and fill in the URLs to load real players.
# .env.local is ignored by git, so test videos stay out of the public repo.
# Copy each URL from the video's Share > Embed option on the platform.
# Leave a value empty to show the placeholder for that source.

# Where the data comes from: "laravel" for the API in backend/ (start it with
# `docker compose up -d app` in backend/), or leave empty for the static
# preview in public/data. `npm run dev:laravel` sets it for you (.env.laravel).
VITE_API_MODE=

VITE_RUMBLE_EMBED_URL=
VITE_ODYSEE_EMBED_URL=
