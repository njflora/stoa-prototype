# Settings for a production server. Copy to .env on the server and fill in
# every value marked CHANGE. The real .env never goes into git.
# SECURITY.md has the full production checklist.

APP_NAME=Stoa
# production: no demo sign-in, no debug pages, strict settings.
APP_ENV=production
# CHANGE: generate a new key on the server with `php artisan key:generate`.
# Never reuse a development key.
APP_KEY=
# Never true in production: debug pages show settings and code to anyone.
APP_DEBUG=false
# CHANGE: the site's real address, over HTTPS.
APP_URL=https://example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

# Errors and warnings only, kept for 14 days.
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

# CHANGE: a database server reachable only from the app, never from the internet.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stoa
DB_USERNAME=stoa
DB_PASSWORD=

# Sessions: encrypted, sent only over HTTPS, hidden from JavaScript, and
# not carried by other sites' form posts or background requests.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
# CHANGE: the site's domain, such as example.com.
SESSION_DOMAIN=

# CHANGE: only the site's own domain signs in with a session cookie. No wildcards.
SANCTUM_STATEFUL_DOMAINS=example.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# CHANGE: a real mail service, for account emails once real accounts exist.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Search: Meilisearch, reachable only from the app.
SCOUT_DRIVER=meilisearch
SCOUT_PREFIX=stoa_
MEILISEARCH_HOST=http://127.0.0.1:7700
# CHANGE: a long random key (at least 16 bytes), the same one Meilisearch starts
# with (MEILI_MASTER_KEY). Run Meilisearch with MEILI_ENV=production.
MEILISEARCH_KEY=
